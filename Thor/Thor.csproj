<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Thor</RootNamespace>
    <AssemblyName>Thor</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <ProjectReference Include="..\ModUtils\ModUtils.csproj" />
    <ProjectReference Include="..\GameBridge\GameBridge.csproj" />
    <Compile Remove="_LEGACY_PathFinder.cs;TestObjects.cs" />
    <None Update="resources\*.wav" CopyToOutputDirectory="PreserveNewest" TargetPath="Thor\%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="WritePackageManifest" AfterTargets="Build">
    <ItemGroup>
      <ModPackageAssembly Include="$(TargetPath)" />
      <ModPackageAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
    <WriteLinesToFile File="$(TargetDir)package-files.txt" Lines="@(ModPackageAssembly->'%(Filename)%(Extension)')" Overwrite="true" />
  </Target>
</Project>
